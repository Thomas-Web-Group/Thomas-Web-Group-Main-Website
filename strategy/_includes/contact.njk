<!-- Contact Section -->
<section id="contact" class="contact section">

  <!-- Section Title -->
  <div class="container section-title" data-aos="fade-up">
    <h2>Get in Touch</h2>
    <div>
      <span>Contact</span>
      <span class="description-title">Thomas Web Group</span>
    </div>
  </div>
  <!-- End Section Title -->

  <div class="container" data-aos="fade-up" data-aos-delay="100">

    <!-- Contact Info Boxes -->
    <div class="row gy-4 mb-5">

      <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
        <div class="contact-info-box">
          <div class="icon-box">
            <i class="bi bi-geo-alt"></i>
          </div>
          <div class="info-content">
            <h4>Location</h4>
            <p>East Tennessee</p>
            <p>Serving businesses nationwide</p>
          </div>
        </div>
      </div>

      <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
        <div class="contact-info-box">
          <div class="icon-box">
            <i class="bi bi-envelope"></i>
          </div>
          <div class="info-content">
            <h4>Email</h4>
            <p>
              <a href="mailto:raymond@thomaswebgroup.com">
                raymond@thomaswebgroup.com
              </a>
            </p>
          </div>
        </div>
      </div>

      <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="300">
        <div class="contact-info-box">
          <div class="icon-box">
            <i class="bi bi-telephone"></i>
          </div>
          <div class="info-content">
            <h4>Phone</h4>
            <p>
              <a href="tel:+14232258787">
                (423) 225-8787
              </a>
            </p>
          </div>
        </div>
      </div>

    </div>
    <!-- /Contact Info Boxes -->

  </div>

  <!-- Contact Form Section -->
  <div class="container form-container-overlap">

    <div class="row justify-content-center" data-aos="fade-up" data-aos-delay="300">

      <div class="col-lg-10">

        <div class="contact-form-wrapper">

          <h2 class="text-center mb-3">What would you like to improve?</h2>

          <p class="text-center mb-4">
            Choose a service and describe what you need. We'll reply by email to arrange a call.
          </p>

          <form name="contact" method="POST" action="/thank-you/" data-netlify="true">

            <input type="hidden" name="form-name" value="contact">

            <div class="row g-3">

              <div class="col-md-6">
                <div class="form-group">
                  <div class="input-with-icon">
                    <i class="bi bi-person"></i>
                    <input
                      type="text"
                      class="form-control"
                      name="name"
                      placeholder="Full Name"
                      required
                    >
                  </div>
                </div>
              </div>

              <div class="col-md-6">
                <div class="form-group">
                  <div class="input-with-icon">
                    <i class="bi bi-envelope"></i>
                    <input
                      type="email"
                      class="form-control"
                      name="email"
                      placeholder="Email"
                      required
                    >
                  </div>
                </div>
              </div>

              <div class="col-md-6">
                <div class="form-group">
                  <div class="input-with-icon">
                    <i class="bi bi-building"></i>
                    <input
                      type="text"
                      class="form-control"
                      name="business_name"
                      placeholder="Business Name"
                      required
                    >
                  </div>
                </div>
              </div>

              <div class="col-md-6">
                <div class="form-group">
                  <div class="input-with-icon">
                    <i class="bi bi-globe"></i>
                    <input
                      type="url"
                      class="form-control"
                      name="current_website"
                      placeholder="Current Website (Optional)"
                    >
                  </div>
                </div>
              </div>

              <div class="col-md-12">
                <div class="form-group">
                  <div class="input-with-icon">
                    <i class="bi bi-list-check"></i>

                    <select
                      class="form-control"
                      name="project_type"
                      required
                    >
                      <option value="" selected disabled>What do you need help with?</option>
                      <option value="website">Website Design &amp; Development</option>
                      <option value="social-media">Social Media Management</option>
                      <option value="crm-business-systems">CRM &amp; Business Systems</option>
                      <option value="growth-automation">Growth Strategy &amp; Automation</option>
                      <option value="ongoing-support">Ongoing Support</option>
                      <option value="not-sure">Not Sure</option>
                    </select>

                  </div>
                </div>
              </div>

              <div class="col-12">
                <div class="form-group">
                  <div class="input-with-icon">
                    <i class="bi bi-chat-dots message-icon"></i>

                    <textarea
                      class="form-control"
                      name="message"
                      placeholder="How can we help?"
                      style="height: 180px"
                      required
                    ></textarea>

                  </div>
                </div>
              </div>

              <div class="col-12 text-center">
                <button
                  type="submit"
                  class="btn btn-primary btn-submit"
                >
                  SEND INQUIRY
                </button>
              </div>

            </div>

          </form>

        </div>

      </div>

    </div>

  </div>
  <!-- /Contact Form Section -->

</section>
<!-- /Contact Section -->
