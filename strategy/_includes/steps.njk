<!-- Steps Section -->
<section id="steps" class="steps section">

  <!-- Section Title -->
  <div class="container section-title" data-aos="fade-up">
    <h2>Process</h2>
    <div>
      <span>From Kickoff to</span>
      <span class="description-title">Launch</span>
    </div>
  </div>
  <!-- End Section Title -->

  <div class="container" data-aos="fade-up" data-aos-delay="100">

    <div class="steps-wrapper">

      <div class="step-item" data-aos="fade-right" data-aos-delay="200">
        <div class="step-content">
          <div class="step-icon">
            <i class="bi bi-clipboard-check"></i>
          </div>

          <div class="step-info">
            <span class="step-number">Step 01</span>
            <h3>Scope</h3>
            <p>
              Tell us what you want to improve. We'll clarify your goals, agree on
              the work involved, and set expectations before we begin.
            </p>
          </div>
        </div>
      </div>
      <!-- End Step Item -->

      <div class="step-item" data-aos="fade-left" data-aos-delay="300">
        <div class="step-content">
          <div class="step-icon">
            <i class="bi bi-code-slash"></i>
          </div>

          <div class="step-info">
            <span class="step-number">Step 02</span>
            <h3>Build</h3>
            <p>
              We put the agreed solution into practice, whether that means a website,
              lead-generation improvements, CRM setup, or connected business systems.
            </p>
          </div>
        </div>
      </div>
      <!-- End Step Item -->

      <div class="step-item" data-aos="fade-right" data-aos-delay="400">
        <div class="step-content">
          <div class="step-icon">
            <i class="bi bi-chat-square-text"></i>
          </div>

          <div class="step-info">
            <span class="step-number">Step 03</span>
            <h3>Review</h3>
            <p>
              Review the work with us and share feedback. We make agreed adjustments
              and confirm the solution addresses the needs we scoped together.
            </p>
          </div>
        </div>
      </div>
      <!-- End Step Item -->

      <div class="step-item" data-aos="fade-left" data-aos-delay="500">
        <div class="step-content">
          <div class="step-icon">
            <i class="bi bi-rocket-takeoff"></i>
          </div>

          <div class="step-info">
            <span class="step-number">Step 04</span>
            <h3>Launch</h3>
            <p>
              We help put the solution to work with your team and explain the handoff.
              Ongoing support or next steps depend on your project and needs.
            </p>
          </div>
        </div>
      </div>
      <!-- End Step Item -->

    </div>

  </div>

</section>
<!-- /Steps Section -->