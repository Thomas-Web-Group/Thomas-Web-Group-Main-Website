<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description or 'Thomas Web Group builds fast, professional business websites with straightforward scope, pricing, and ownership.' }}">
  {% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
  {% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description or 'Thomas Web Group builds fast, professional business websites with straightforward scope, pricing, and ownership.' }}">
  <meta property="og:type" content="website">
  {% set assetRoot = './' %}
  {% if page.url != '/' %}{% set assetRoot = '../' %}{% endif %}
  {% if page.url == '/work/dad-cuts-grass/' or page.url == '/work/smoky-mountain-acres/' %}{% set assetRoot = '../../' %}{% endif %}
  <base href="{{ assetRoot }}">

  <!-- Favicons -->
  <link href="{{ assetRoot }}assets/img/uploads/logo_dark_transparent_square_cropped.webp" rel="icon">
  <link href="{{ assetRoot }}assets/img/uploads/logo_dark_transparent_square_cropped.webp" rel="apple-touch-icon">

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Nunito+Sans:ital,wght@0,200;0,300;0,400;0,600;0,700;0,800;0,900;1,200;1,300;1,400;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="{{ assetRoot }}assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="{{ assetRoot }}assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="{{ assetRoot }}assets/vendor/aos/aos.css" rel="stylesheet">
  <link href="{{ assetRoot }}assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">
  <link href="{{ assetRoot }}assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">

  <!-- Main CSS File -->
  <link href="{{ assetRoot }}assets/css/main.css" rel="stylesheet">

</head>
<body class="index-page">

  {% include 'header.njk' %}
  {{ content | safe }}
  {% include 'footer.njk' %}

</body>
</html>