<!-- FAQ Section -->
<section id="faq" class="portfolio-details section">

  <!-- Section Title -->
  <div class="container section-title" data-aos="fade-up">
    <h2>FAQ</h2>
    <div>
      <span>Common</span>
      <span class="description-title">Questions</span>
    </div>
  </div>
  <!-- End Section Title -->

  <div class="container" data-aos="fade-up" data-aos-delay="100">

    <div class="row justify-content-center">

      <div class="col-lg-10">

        <div class="portfolio-details-content">

          <div class="project-overview">

            <div
              class="accordion project-accordion"
              id="faqAccordion"
            >

              <!-- FAQ 1 -->
              <div class="accordion-item" data-aos="fade-up">

                <h2 class="accordion-header">
                  <button
                    class="accordion-button"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#faq-collapse-1"
                    aria-expanded="true"
                    aria-controls="faq-collapse-1"
                  >
                    <i class="bi bi-currency-dollar me-2"></i>
                    How much does a website cost?
                  </button>
                </h2>

                <div
                  id="faq-collapse-1"
                  class="accordion-collapse collapse show"
                  data-bs-parent="#faqAccordion"
                >
                  <div class="accordion-body">
                    <p>
                      Most projects cost between $1,500 and $5,000. Small,
                      straightforward websites are near the lower end. Larger
                      sites, custom functionality, integrations, and CMS
                      projects cost more.
                    </p>
                  </div>
                </div>

              </div>
              <!-- /FAQ 1 -->


              <!-- FAQ 2 -->
              <div class="accordion-item" data-aos="fade-up">

                <h2 class="accordion-header">
                  <button
                    class="accordion-button collapsed"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#faq-collapse-2"
                    aria-expanded="false"
                    aria-controls="faq-collapse-2"
                  >
                    <i class="bi bi-clock me-2"></i>
                    How long does it take to build a website?
                  </button>
                </h2>

                <div
                  id="faq-collapse-2"
                  class="accordion-collapse collapse"
                  data-bs-parent="#faqAccordion"
                >
                  <div class="accordion-body">
                    <p>
                      Most standard websites take about 2-3 weeks once we have
                      the content, access, and project requirements needed to begin.
                      Larger or CMS-driven websites receive their own project timeline.
                    </p>
                  </div>
                </div>

              </div>
              <!-- /FAQ 2 -->


              <!-- FAQ 3 -->
              <div class="accordion-item" data-aos="fade-up">

                <h2 class="accordion-header">
                  <button
                    class="accordion-button collapsed"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#faq-collapse-3"
                    aria-expanded="false"
                    aria-controls="faq-collapse-3"
                  >
                    <i class="bi bi-file-earmark-check me-2"></i>
                    Do I own the website?
                  </button>
                </h2>

                <div
                  id="faq-collapse-3"
                  class="accordion-collapse collapse"
                  data-bs-parent="#faqAccordion"
                >
                  <div class="accordion-body">
                    <p>
                      Yes. Once your project is paid in full, you own the
                      project-specific website code and client-provided content.
                      Third-party software, fonts, libraries, and licensed assets
                      remain subject to their respective licenses.
                    </p>
                  </div>
                </div>

              </div>
              <!-- /FAQ 3 -->


              <!-- FAQ 4 -->
              <div class="accordion-item" data-aos="fade-up">

                <h2 class="accordion-header">
                  <button
                    class="accordion-button collapsed"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#faq-collapse-4"
                    aria-expanded="false"
                    aria-controls="faq-collapse-4"
                  >
                    <i class="bi bi-cloud-arrow-up me-2"></i>
                    Do I have to host with Thomas Web Group?
                  </button>
                </h2>

                <div
                  id="faq-collapse-4"
                  class="accordion-collapse collapse"
                  data-bs-parent="#faqAccordion"
                >
                  <div class="accordion-body">
                    <p>
                      No. Managed hosting is available for convenience, but it
                      is not required. If you decide to host elsewhere, we can
                      provide the project code for handoff.
                    </p>
                  </div>
                </div>

              </div>
              <!-- /FAQ 4 -->


              <!-- FAQ 5 -->
              <div class="accordion-item" data-aos="fade-up">

                <h2 class="accordion-header">
                  <button
                    class="accordion-button collapsed"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#faq-collapse-5"
                    aria-expanded="false"
                    aria-controls="faq-collapse-5"
                  >
                    <i class="bi bi-pencil-square me-2"></i>
                    Can I edit the website myself?
                  </button>
                </h2>

                <div
                  id="faq-collapse-5"
                  class="accordion-collapse collapse"
                  data-bs-parent="#faqAccordion"
                >
                  <div class="accordion-body">
                    <p>
                      Standard static websites are intended for businesses that
                      do not need frequent internal editing. If regular in-house
                      editing is important, we can recommend a CMS such as
                      ExpressionEngine.
                    </p>
                  </div>
                </div>

              </div>
              <!-- /FAQ 5 -->


              <!-- FAQ 6 -->
              <div class="accordion-item" data-aos="fade-up">

                <h2 class="accordion-header">
                  <button
                    class="accordion-button collapsed"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#faq-collapse-6"
                    aria-expanded="false"
                    aria-controls="faq-collapse-6"
                  >
                    <i class="bi bi-search me-2"></i>
                    Do you provide SEO?
                  </button>
                </h2>

                <div
                  id="faq-collapse-6"
                  class="accordion-collapse collapse"
                  data-bs-parent="#faqAccordion"
                >
                  <div class="accordion-body">
                    <p>
                      Every website includes foundational technical SEO and is
                      built to be crawlable, mobile-friendly, fast, and clearly
                      structured. We do not currently sell ongoing SEO retainers
                      or guarantee search rankings.
                    </p>
                  </div>
                </div>

              </div>
              <!-- /FAQ 6 -->


              <!-- FAQ 7 -->
              <div class="accordion-item" data-aos="fade-up">

                <h2 class="accordion-header">
                  <button
                    class="accordion-button collapsed"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#faq-collapse-7"
                    aria-expanded="false"
                    aria-controls="faq-collapse-7"
                  >
                    <i class="bi bi-stars me-2"></i>
                    What about AI search or AEO?
                  </button>
                </h2>

                <div
                  id="faq-collapse-7"
                  class="accordion-collapse collapse"
                  data-bs-parent="#faqAccordion"
                >
                  <div class="accordion-body">
                    <p>
                      We build for modern search using the same technical and
                      content fundamentals that support traditional search
                      visibility. We do not sell a separate AEO package or rely
                      on unsupported AI-search tricks.
                    </p>
                  </div>
                </div>

              </div>
              <!-- /FAQ 7 -->


              <!-- FAQ 8 -->
              <div class="accordion-item" data-aos="fade-up">

                <h2 class="accordion-header">
                  <button
                    class="accordion-button collapsed"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#faq-collapse-8"
                    aria-expanded="false"
                    aria-controls="faq-collapse-8"
                  >
                    <i class="bi bi-diagram-3 me-2"></i>
                    Can you connect the site to my CRM or scheduling system?
                  </button>
                </h2>

                <div
                  id="faq-collapse-8"
                  class="accordion-collapse collapse"
                  data-bs-parent="#faqAccordion"
                >
                  <div class="accordion-body">
                    <p>
                      Usually. We can connect straightforward website forms,
                      scheduling tools, and lead submissions to existing systems
                      when the project requires it. Ongoing administration of
                      those external systems is outside the standard website scope.
                    </p>
                  </div>
                </div>

              </div>
              <!-- /FAQ 8 -->


              <!-- FAQ 9 -->
              <div class="accordion-item" data-aos="fade-up">

                <h2 class="accordion-header">
                  <button
                    class="accordion-button collapsed"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#faq-collapse-9"
                    aria-expanded="false"
                    aria-controls="faq-collapse-9"
                  >
                    <i class="bi bi-file-text me-2"></i>
                    Do you write all the website content?
                  </button>
                </h2>

                <div
                  id="faq-collapse-9"
                  class="accordion-collapse collapse"
                  data-bs-parent="#faqAccordion"
                >
                  <div class="accordion-body">
                    <p>
                      Basic editing and page-structure guidance can be included
                      in the project. Substantial copywriting, photography, or
                      specialized creative production can be added to the scope
                      when needed.
                    </p>
                  </div>
                </div>

              </div>
              <!-- /FAQ 9 -->


              <!-- FAQ 10 -->
              <div class="accordion-item" data-aos="fade-up">

                <h2 class="accordion-header">
                  <button
                    class="accordion-button collapsed"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#faq-collapse-10"
                    aria-expanded="false"
                    aria-controls="faq-collapse-10"
                  >
                    <i class="bi bi-arrow-repeat me-2"></i>
                    What happens after launch?
                  </button>
                </h2>

                <div
                  id="faq-collapse-10"
                  class="accordion-collapse collapse"
                  data-bs-parent="#faqAccordion"
                >
                  <div class="accordion-body">
                    <p>
                      The website can remain on Thomas Web Group managed hosting
                      or be handed off. Small post-launch changes are available
                      hourly, while larger additions are quoted separately.
                      There is no required development retainer.
                    </p>
                  </div>
                </div>

              </div>
              <!-- /FAQ 10 -->

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>
<!-- /FAQ Section -->