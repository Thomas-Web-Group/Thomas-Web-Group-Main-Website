<main class="main">
  <section class="about section">
    <div class="container section-title" data-aos="fade-up">
      <h2>{{ service.eyebrow }}</h2>
    </div>

    <div class="container">
      <div class="row gx-5 align-items-center">
        <div class="col-lg-6" data-aos="fade-right" data-aos-delay="200">
          <div class="about-image position-relative">
            <img src="{{ service.image }}" class="img-fluid rounded-4 shadow-sm" alt="{{ service.imageAlt }}" loading="eager">
          </div>
        </div>
        <div class="col-lg-6 mt-4 mt-lg-0" data-aos="fade-left" data-aos-delay="300">
          <div class="about-content">
            <h1>{{ service.heading }}</h1>
            <p class="lead">{{ service.intro }}</p>
            <a href="/contact/" class="btn btn-primary">Let's Talk</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="services section">
    <div class="container section-title" data-aos="fade-up">
      <h2>Included</h2>
    </div>
    <div class="container">
      <div class="row gy-4">
        {% for item in service.highlights %}
        <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="{{ loop.index * 100 }}">
          <div class="service-card h-100">
            <div class="service-icon"><i class="bi {{ item.icon }}"></i></div>
            <h3>{{ item.title }}</h3>
            <p class="mb-0">{{ item.text }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

</main>
